<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="8px"
    paddingRight="8px"
    paddingBottom="8px"
    paddingLeft="8px"
    backgroundColor="#090d14">

    <brls:Box width="auto" height="40px" axis="row" alignItems="center">
        <brls:Label
            id="clock" width="110px" height="auto"
            text="--:--" fontSize="28"
            horizontalAlign="left" />
        <brls:Box
            width="48px" height="36px" axis="row" alignItems="center"
            backgroundColor="#111925" cornerRadius="12">
            <brls:Label
                id="connection" width="0px" height="0px"
                text="" fontSize="1"
                horizontalAlign="left" textColor="#91a0b5" />
            <brls:Button
                id="connection-button"
                text="●"
                width="48px" height="36px" />
        </brls:Box>
        <brls:Label
            id="battery" width="auto" height="auto" grow="1.0"
            text="--%" fontSize="18"
            horizontalAlign="right" />
    </brls:Box>

    <brls:Box width="auto" height="auto" axis="row" grow="1.0" marginTop="6px">
        <brls:Box
            id="widget-gps"
            width="auto" height="auto" axis="column" grow="1.0"
            backgroundColor="#111925" cornerRadius="12">
            <AndroidAutoVideoView
                id="map-image"
                width="auto" height="auto" grow="1.0"
                scalingType="fill" />
        </brls:Box>

        <brls:Box width="auto" height="auto" axis="column" grow="1.0" marginLeft="12px">
            <brls:Box
                id="widget-speed"
                width="auto" height="122px" axis="row"
                justifyContent="center" alignItems="center"
                paddingTop="18px" paddingRight="24px" paddingBottom="18px" paddingLeft="24px"
                backgroundColor="#111925" cornerRadius="24">
                <brls:Label id="speed" text="0" fontSize="58" width="145px" horizontalAlign="right" />
                <brls:Label id="speed-unit" text="@i18n/switch_auto/dashboard/speed_unit" fontSize="20" width="70px" marginLeft="10px" textColor="#91a0b5" />
            </brls:Box>
            <brls:Box
                width="auto" height="106px" axis="column" marginTop="16px"
                paddingTop="14px" paddingRight="22px" paddingBottom="14px" paddingLeft="22px"
                backgroundColor="#111925" cornerRadius="24">
                <brls:Label text="@i18n/switch_auto/gps/title" fontSize="15" height="26px" horizontalAlign="left" textColor="#f04455" />
                <brls:Label id="gps-status" text="@i18n/switch_auto/gps/waiting" fontSize="17" height="30px" horizontalAlign="left" />
                <brls:Label id="gps-coordinates" text="@i18n/switch_auto/gps/no_position" fontSize="13" height="auto" horizontalAlign="left" textColor="#91a0b5" />
            </brls:Box>
            <brls:Box
                id="widget-media"
                width="auto" height="auto" axis="column" grow="1.0" marginTop="16px"
                paddingTop="30px" paddingRight="30px" paddingBottom="30px" paddingLeft="30px"
                backgroundColor="#111925" cornerRadius="24">
                <brls:Label text="@i18n/switch_auto/dashboard/now_playing" fontSize="18" height="42px" horizontalAlign="left" textColor="#91a0b5" />
                <brls:Label id="track" text="@i18n/switch_auto/media/no_media" fontSize="30" height="64px" horizontalAlign="left" />
                <brls:Label id="artist" text="@i18n/switch_auto/media/companion_offline" fontSize="20" height="auto" horizontalAlign="left" textColor="#91a0b5" grow="1.0" />
                <brls:Box width="auto" height="58px" axis="row" marginTop="12px">
                    <brls:Button id="media-previous" text="&lt;" width="60px" height="54px" />
                    <brls:Button id="media-play-pause" text="PLAY" width="88px" height="54px" marginLeft="8px" />
                    <brls:Button id="media-next" text="&gt;" width="60px" height="54px" marginLeft="8px" />
                </brls:Box>
            </brls:Box>
        </brls:Box>
    </brls:Box>
</brls:Box>
