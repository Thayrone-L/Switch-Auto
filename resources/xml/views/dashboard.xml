<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="38px"
    paddingRight="48px"
    paddingBottom="38px"
    paddingLeft="48px"
    backgroundColor="#090d14">

    <brls:Box width="auto" height="72px" axis="row" alignItems="center">
        <brls:Label
            width="24%" height="auto"
            text="@i18n/switch_auto/title" fontSize="24"
            horizontalAlign="left" textColor="#f04455" />
        <brls:Label
            id="clock" width="22%" height="auto"
            text="--:--" fontSize="46"
            horizontalAlign="center" />
        <brls:Box
            width="34%" height="54px" axis="row" alignItems="center"
            paddingLeft="18px" paddingRight="6px"
            backgroundColor="#111925" cornerRadius="18">
            <brls:Label
                id="connection" width="auto" height="auto" grow="1.0"
                text="@i18n/switch_auto/status/offline" fontSize="17"
                horizontalAlign="left" textColor="#91a0b5" />
            <brls:Button
                id="connection-button"
                text="@i18n/switch_auto/connection/open"
                width="132px" height="42px" />
        </brls:Box>
        <brls:Label
            id="battery" width="20%" height="auto"
            text="--%" fontSize="22"
            horizontalAlign="right" />
    </brls:Box>

    <brls:Box width="auto" height="auto" axis="row" grow="1.0" marginTop="22px">
        <brls:Box
            width="58%" height="auto" axis="column"
            justifyContent="center" alignItems="center"
            backgroundColor="#111925" cornerRadius="24">
            <brls:Label id="speed" text="0" fontSize="112" height="135px" />
            <brls:Label id="speed-unit" text="@i18n/switch_auto/dashboard/speed_unit" fontSize="25" height="45px" textColor="#91a0b5" />
        </brls:Box>

        <brls:Box width="auto" height="auto" axis="column" grow="1.0" marginLeft="24px">
            <brls:Box
                width="auto" height="auto" axis="column" grow="1.0"
                paddingTop="30px" paddingRight="30px" paddingBottom="30px" paddingLeft="30px"
                backgroundColor="#111925" cornerRadius="24">
                <brls:Label text="@i18n/switch_auto/dashboard/now_playing" fontSize="18" height="42px" horizontalAlign="left" textColor="#91a0b5" />
                <brls:Label id="track" text="@i18n/switch_auto/media/no_media" fontSize="30" height="64px" horizontalAlign="left" />
                <brls:Label id="artist" text="@i18n/switch_auto/media/companion_offline" fontSize="20" height="auto" horizontalAlign="left" textColor="#91a0b5" grow="1.0" />
            </brls:Box>
        </brls:Box>
    </brls:Box>
</brls:Box>
